# Demo works without these. Copy this file to .env.local for live accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# For live auth/custom domains, match the public origin and Supabase redirect allowlist.
# Leave unset for a demo-only Vercel deployment: Vercel supplies its own address.
APP_URL=http://localhost:3000
# No Twilio, payment, or AI services are enabled in Phase 1.
